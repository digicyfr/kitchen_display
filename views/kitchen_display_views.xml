<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kitchen Display Tree View -->
    <record id="kitchen_display_tree_view" model="ir.ui.view">
        <field name="name">kitchen.display.tree</field>
        <field name="model">kitchen.display</field>
        <field name="arch" type="xml">
            <tree string="Kitchen Displays">
                <field name="name"/>
                <field name="location"/>
                <field name="display_type"/>
                <field name="is_active"/>
                <field name="auto_refresh_interval"/>
            </tree>
        </field>
    </record>

    <!-- Kitchen Display Form View -->
    <record id="kitchen_display_form_view" model="ir.ui.view">
        <field name="name">kitchen.display.form</field>
        <field name="model">kitchen.display</field>
        <field name="arch" type="xml">
            <form string="Kitchen Display">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Display Name"/></h1>
                    </div>
                    <group>
                        <group name="basic_info">
                            <field name="location"/>
                            <field name="display_type"/>
                            <field name="is_active"/>
                        </group>
                        <group name="display_settings">
                            <field name="auto_refresh_interval"/>
                            <field name="max_orders_display"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appearance" name="appearance">
                            <group>
                                <group name="colors">
                                    <field name="background_color"/>
                                    <field name="text_color"/>
                                    <field name="font_size"/>
                                </group>
                                <group name="display_options">
                                    <field name="show_customer_name"/>
                                    <field name="show_order_time"/>
                                    <field name="show_special_instructions"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kitchen Display Action -->
    <record id="kitchen_display_action" model="ir.actions.act_window">
        <field name="name">Kitchen Displays</field>
        <field name="res_model">kitchen.display</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first kitchen display!
            </p>
            <p>
                Kitchen displays help manage order flow in your restaurant kitchen.
                Configure displays for different stations like preparation, cooking, or ready-to-serve.
            </p>
        </field>
    </record>
</odoo>